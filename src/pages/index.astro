---
import { Image } from 'astro:assets'
import aiProposal from '../assets/ai-proposal.png'
import email from '../assets/email.png'
import pdf from '../assets/pdf.png'
import schedule from '../assets/schedule.png'
import icon from '../assets/icon.svg?raw'
import CopyCommand from '../components/CopyCommand.astro'
import Header from '../components/Header.astro'
import HeroFlow from '../components/HeroFlow.astro'
import VideoPlate from '../components/VideoPlate.astro'
import Base from '../layouts/Base.astro'

const title = 'Rowbird: scheduled SQL reports and data alerts, self-hosted'
const description =
  'Rowbird runs your SQL queries on a schedule and delivers the results to email, Slack, Telegram, Discord, webhooks and S3, as a table or as CSV, Excel and PDF. Open source, one binary, no telemetry.'
const run = 'docker run -p 8080:8080 -v rowbird-data:/data ghcr.io/rowbird/rowbird:1'

const destinations = [
  { name: 'Email', note: 'SMTP, HTML table plus plain text', modes: [1, 1, 1] },
  { name: 'Slack', note: 'Bot token or incoming webhook', modes: [1, 1, 1] },
  { name: 'Telegram', note: 'Bots, files up to 50 MB', modes: [1, 1, 1] },
  { name: 'Discord', note: 'Webhooks, Markdown tables', modes: [1, 1, 1] },
  { name: 'Webhook', note: 'JSON, signed with HMAC-SHA256', modes: [1, 0, 1] },
  { name: 'S3', note: 'AWS, MinIO, R2, B2, Wasabi, Spaces', modes: [0, 1, 0] },
  { name: 'Uptime Kuma', note: 'Push monitor, up or down per run', modes: [1, 0, 0] },
]
const databases = ['PostgreSQL', 'MySQL', 'MariaDB', 'SQL Server', 'SQLite']
const formats = ['CSV', 'Excel', 'JSON', 'PDF', 'HTML table', 'Markdown', 'Text']
const conditions = [
  ['has_rows', 'Only when there is something to say.'],
  ['row_count > 50', 'When the list gets long.'],
  ['revenue < 1000', 'When a number crosses a line.'],
  ['changed', 'Only when the result changed since the last time.'],
]
const trust = [
  ['Read-only by default', 'Read-only transactions, server-side timeouts, row limits and one statement per query. Rowbird warns you when a login can write.'],
  ['Parameters are bound, always', 'Built-in dates like {{yesterday}} and your own parameters reach the database as driver parameters, never pasted into SQL.'],
  ['Secrets stay secret', 'Credentials are encrypted with AES-256-GCM and never shown again: not in the UI, the API, the logs or an export.'],
  ['Your people, your rules', 'Admin, editor and viewer roles, TOTP and passkeys, OIDC single sign-on, scoped API keys and a security log.'],
  ['AI that never sees a row', 'The optional assistant gets your question and the schema. Rows never leave, and nothing runs until you apply it.'],
  ['No telemetry', 'Rowbird talks to what you configure. The one exception, a daily update check, turns off with a switch.'],
]
---

<Base title={title} description={description}>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="mx-auto grid max-w-[1320px] gap-14 px-5 pt-12 pb-8 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16 lg:pt-20 lg:pb-16">
      <div class="min-w-0">
        <h1 class="display text-[11vw] font-medium text-bark sm:text-[8.4vw] lg:text-[clamp(3rem,4.9vw,5.4rem)]"><span class="whitespace-nowrap">Your SQL results,</span><br /><em>delivered.</em></h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-bark/85 sm:text-xl">
          Rowbird runs your queries on a schedule and delivers the results where your team already reads: a table in the
          email, or CSV, Excel and PDF in Slack, Telegram, Discord, a webhook or a bucket. Add a condition and it becomes an
          alert.
        </p>
        <div class="mt-8"><CopyCommand command="docker run -p 8080:8080 ghcr.io/rowbird/rowbird" /></div>
        <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-mute">
          <a class="underline decoration-rule underline-offset-4 transition hover:text-breast-ink hover:decoration-breast-ink" href="#tour">Watch the 21-second tour</a>
          <a class="underline decoration-rule underline-offset-4 transition hover:text-breast-ink hover:decoration-breast-ink" href="https://docs.rowbird.dev/guide/demo">Try the demo</a>
          <a class="underline decoration-rule underline-offset-4 transition hover:text-breast-ink hover:decoration-breast-ink" href="https://github.com/rowbird/rowbird">Star on GitHub</a>
        </p>
      </div>
      <HeroFlow />
    </section>

    <!-- Tour -->
    <section id="tour" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-10 sm:px-8 sm:pt-16" aria-labelledby="tour-title">
      <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
        <h2 id="tour-title" class="display text-[clamp(2rem,3.6vw,3rem)] font-normal text-bark">Watch it <em>work.</em></h2>
        <p class="label">21 seconds, recorded on a real Rowbird</p>
      </div>
      <VideoPlate />
    </section>

    <!-- The problem -->
    <section class="mt-24 bg-bark text-cream sm:mt-32" aria-labelledby="problem">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 md:grid-cols-[1.4fr_1fr]">
        <h2 id="problem" class="display text-[clamp(2.4rem,5.5vw,4.4rem)] font-normal text-paper">
          Somebody on your team is a <em>human cron job.</em>
        </h2>
        <div class="self-end">
          <ul class="space-y-4 font-mono text-[0.95rem] text-cream/70">
            <li class="line-through decoration-breast decoration-2">A cron script only one person understands.</li>
            <li class="line-through decoration-breast decoration-2">A BI tool licensed for one table.</li>
            <li class="line-through decoration-breast decoration-2">Copy. Paste. Send. Tomorrow again.</li>
          </ul>
          <p class="mt-8 text-lg leading-relaxed text-cream/90">
            Rowbird is the small tool that does exactly this job, well, on your own server. It is not a dashboard. It is the
            report that shows up.
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-24 sm:px-8 sm:py-32" aria-labelledby="how-title">
      <p class="label">How it works</p>
      <h2 id="how-title" class="display mt-4 max-w-3xl text-[clamp(2.4rem,5vw,4rem)] font-normal text-bark">
        Three steps, and then it runs <em>without you.</em>
      </h2>

      <div class="mt-20 space-y-28">
        <article class="grid gap-10 [&>*]:min-w-0 md:grid-cols-[1fr_1.35fr] md:items-center">
          <div>
            <p class="display text-6xl text-breast-2">01</p>
            <h3 class="display mt-3 text-4xl text-bark">Write it, or ask for it.</h3>
            <p class="mt-4 text-lg leading-relaxed text-bark/80">
              Write SQL with schema autocomplete and a live preview. Or describe what you need, and the optional assistant
              (OpenAI, Anthropic, Gemini, Ollama or any compatible endpoint) proposes the query as a change you can read
              before you apply it.
            </p>
            <p class="mt-5 font-mono text-sm text-mute">
              <span class="text-breast-ink">Supports</span> {databases.join(' · ')}, with TLS and SSH tunnels.
            </p>
          </div>
          <figure class="relative">
            <div class="plate">
              <Image src={aiProposal} alt="The Rowbird assistant proposing SQL for orders and revenue per region yesterday, rounded to cents, with an explanation and a diff." widths={[680, 1360]} sizes="(min-width: 768px) 640px, 100vw" class="block w-full" />
            </div>
            <figcaption class="label mt-4">Fig. 2 · A real proposal from the assistant, shown as a diff</figcaption>
          </figure>
        </article>

        <article class="grid gap-10 [&>*]:min-w-0 md:grid-cols-[1.35fr_1fr] md:items-center">
          <figure class="order-2 md:order-1">
            <div class="plate">
              <Image src={schedule} alt="The report schedule: weekdays at 07:00 in America/Sao_Paulo, the cron expression, and the next five runs." widths={[680, 1360]} sizes="(min-width: 768px) 640px, 100vw" class="block w-full" />
            </div>
            <figcaption class="label mt-4">Fig. 3 · Weekdays at 07:00, with the next five runs</figcaption>
          </figure>
          <div class="order-1 md:order-2">
            <p class="display text-6xl text-breast-2">02</p>
            <h3 class="display mt-3 text-4xl text-bark">Put it on a schedule.</h3>
            <p class="mt-4 text-lg leading-relaxed text-bark/80">
              Cron with a time zone, a visual builder, and the next runs spelled out before you save. 07:00 stays 07:00
              across daylight saving. Retries, misfire and overlap policies, and a report that keeps failing pauses itself
              and tells you why.
            </p>
            <pre class="mt-6 overflow-x-auto rounded-lg border border-rule bg-paper-2 px-4 py-3 font-mono text-sm text-bark"><span class="tok-s">0 7 * * 1-5</span>  <span class="tok-c">at 07:00, Monday through Friday</span></pre>
          </div>
        </article>

        <article class="grid gap-10 [&>*]:min-w-0 md:grid-cols-[1fr_1.35fr] md:items-center">
          <div>
            <p class="display text-6xl text-breast-2">03</p>
            <h3 class="display mt-3 text-4xl text-bark">Deliver it where people read.</h3>
            <p class="mt-4 text-lg leading-relaxed text-bark/80">
              A clean table in the body of the message, files attached, or a download link that expires, needs a sign-in if
              you want, and keeps a log of who opened it. Files too big for a destination fall back to a link on their own.
            </p>
            <p class="mt-5 flex flex-wrap gap-2">
              {formats.map((f) => <span class="rounded-md border border-rule bg-white px-2.5 py-1 font-mono text-xs text-bark">{f}</span>)}
            </p>
          </div>
          <figure class="relative">
            <div class="plate">
              <div class="flex items-center justify-between border-b border-rule bg-paper px-5 py-3 text-sm">
                <span class="font-semibold text-bark">Daily sales: 5 regions</span>
                <span class="font-mono text-xs text-mute">07:00 · from Rowbird</span>
              </div>
              <Image src={email} alt="The email Rowbird sends: Daily sales, with a table of orders and revenue per region and a link to the run." widths={[700, 1400]} sizes="(min-width: 768px) 640px, 100vw" class="block w-full" />
              <div class="flex flex-wrap gap-2 border-t border-rule bg-paper px-5 py-3 font-mono text-xs text-bark">
                <span class="rounded bg-white px-2 py-1 ring-1 ring-rule">daily-sales.csv</span>
                <span class="rounded bg-white px-2 py-1 ring-1 ring-rule">daily-sales.xlsx</span>
                <span class="rounded bg-white px-2 py-1 ring-1 ring-rule">daily-sales.pdf</span>
              </div>
            </div>
            <div class="plate absolute -top-8 -right-5 hidden w-[42%] rotate-[3deg] lg:block">
              <Image src={pdf} alt="The first page of the PDF Rowbird generates for the report." widths={[400, 800]} sizes="280px" class="block w-full" />
            </div>
            <figcaption class="label mt-4">Fig. 4 · The actual email, with its attachments</figcaption>
          </figure>
        </article>
      </div>
    </section>

    <!-- Destinations -->
    <section id="destinations" class="scroll-mt-20 border-y border-rule bg-paper-2" aria-labelledby="dest-title">
      <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
        <div class="grid gap-8 md:grid-cols-[1fr_1.6fr]">
          <div>
            <p class="label">Destinations</p>
            <h2 id="dest-title" class="display mt-4 text-[clamp(2.2rem,4.5vw,3.6rem)] font-normal text-bark">
              Wherever your team <em>already reads.</em>
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-bark/80">
              One report can go to several places, each in its own mode. Templates set the subject and the message, with
              values escaped for each destination.
            </p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left">
              <caption class="sr-only">Destinations and the delivery modes each supports</caption>
              <thead>
                <tr class="label border-b border-bark/20">
                  <th scope="col" class="py-3 pr-4 font-normal">Destination</th>
                  <th scope="col" class="px-2 py-3 text-center font-normal sm:px-3">Inline</th>
                  <th scope="col" class="px-2 py-3 text-center font-normal sm:px-3">Files</th>
                  <th scope="col" class="px-2 py-3 text-center font-normal sm:px-3">Link</th>
                </tr>
              </thead>
              <tbody>
                {destinations.map((d) => (
                  <tr class="border-b border-rule">
                    <th scope="row" class="py-4 pr-4 font-normal">
                      <span class="display block text-2xl text-bark">{d.name}</span>
                      <span class="text-sm text-mute">{d.note}</span>
                    </th>
                    {d.modes.map((m) => (
                      <td class="px-2 py-4 text-center sm:px-3">
                        {m ? <><span class="inline-block size-3 rounded-full bg-breast" aria-hidden="true" /><span class="sr-only">Supported</span></> : <><span class="inline-block h-px w-3 bg-rule align-middle" aria-hidden="true" /><span class="sr-only">Not supported</span></>}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Alerts -->
    <section id="alerts" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-24 sm:px-8 sm:py-32" aria-labelledby="alerts-title">
      <div class="grid gap-14 md:grid-cols-2">
        <div>
          <p class="label">Alerts</p>
          <h2 id="alerts-title" class="display mt-4 text-[clamp(2.2rem,4.5vw,3.6rem)] font-normal text-bark">
            Reports that only speak up <em>when it matters.</em>
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-bark/80">
            Add a condition and a report becomes an alert. Combine rules with all or any. When Rowbird itself has a problem,
            it tells you too: an alert channel with a fallback, grouped messages, a note when things recover, and a heartbeat
            for your uptime monitor.
          </p>
        </div>
        <ol class="divide-y divide-rule border-y border-rule">
          {conditions.map(([code, text], i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 py-5">
              <span class="label pt-1">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <code class="font-mono text-[0.95rem] text-breast-ink">{code}</code>
                <p class="display mt-1 text-2xl text-bark">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Trust -->
    <section class="bg-bark text-cream" aria-labelledby="trust-title">
      <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
        <p class="label text-cream/60">Production access, handled with care</p>
        <h2 id="trust-title" class="display mt-4 max-w-3xl text-[clamp(2.2rem,4.5vw,3.6rem)] font-normal text-paper">
          It reads your database. <em>It never writes to it.</em>
        </h2>
        <dl class="mt-16 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {trust.map(([t, d]) => (
            <div class="border-t border-cream/15 pt-5">
              <dt class="display text-2xl text-paper">{t}</dt>
              <dd class="mt-2 leading-relaxed text-cream/75">{d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Config as code -->
    <section class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32" aria-labelledby="yaml-title">
      <div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:items-center">
        <div>
          <p class="label">Config as code</p>
          <h2 id="yaml-title" class="display mt-4 text-[clamp(2.2rem,4.5vw,3.6rem)] font-normal text-bark">
            Reports you can <em>review in a pull request.</em>
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-bark/80">
            Export any report as YAML, keep it in Git, and apply it with <code class="font-mono text-base text-breast-ink">rowbird apply</code>, which prints the plan before it changes anything. Or point Rowbird at a directory and it applies it at every start. Secrets never go in the file.
          </p>
        </div>
        <figure class="plate">
          <div class="flex items-center gap-2 border-b border-rule bg-paper px-4 py-2.5">
            <span class="size-2.5 rounded-full bg-rule"></span><span class="size-2.5 rounded-full bg-rule"></span><span class="size-2.5 rounded-full bg-rule"></span>
            <span class="ml-3 font-mono text-xs text-mute">reports/daily-sales.yaml</span>
          </div>
          <pre class="overflow-x-auto bg-white px-5 py-5 font-mono text-[0.85rem] leading-relaxed text-bark"><span class="tok-k">apiVersion</span>: rowbird.dev/v1
<span class="tok-k">kind</span>: Report
<span class="tok-k">metadata</span>:
  <span class="tok-k">name</span>: daily-sales
<span class="tok-k">spec</span>:
  <span class="tok-k">query</span>: {'{'} <span class="tok-k">ref</span>: sales-by-region {'}'}
  <span class="tok-k">schedule</span>: {'{'} <span class="tok-k">cron</span>: <span class="tok-s">"0 7 * * 1-5"</span>, <span class="tok-k">timezone</span>: America/Sao_Paulo {'}'}
  <span class="tok-k">condition</span>: {'{'} <span class="tok-k">match</span>: all, <span class="tok-k">rules</span>: [{'{'} <span class="tok-k">type</span>: has_rows {'}'}] {'}'}
  <span class="tok-k">deliveries</span>:
    - <span class="tok-k">channel</span>: sales-slack
      <span class="tok-k">mode</span>: attachment
      <span class="tok-k">formats</span>: [xlsx, pdf]
    - <span class="tok-k">channel</span>: finance-email
      <span class="tok-k">mode</span>: link
      <span class="tok-k">link</span>: {'{'} <span class="tok-k">expiresIn</span>: <span class="tok-n">7d</span>, <span class="tok-k">requireLogin</span>: <span class="tok-n">true</span> {'}'}</pre>
        </figure>
      </div>
    </section>

    <!-- Not -->
    <section class="border-y border-rule" aria-labelledby="not-title">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 md:grid-cols-[1fr_2fr] md:items-baseline">
        <h2 id="not-title" class="display text-3xl text-bark">What Rowbird is not.</h2>
        <ul class="grid gap-x-10 gap-y-4 text-bark/80 sm:grid-cols-2">
          <li><strong class="font-semibold text-bark">Not a BI tool.</strong> No chart builder, no dashboards to maintain.</li>
          <li><strong class="font-semibold text-bark">Not an ETL tool.</strong> It does not move data between databases.</li>
          <li><strong class="font-semibold text-bark">Not an uptime monitor.</strong> It reports to yours, like Uptime Kuma.</li>
          <li><strong class="font-semibold text-bark">Never a writer.</strong> Your data stays exactly as it was.</li>
        </ul>
      </div>
    </section>

    <!-- Install -->
    <section id="install" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-24 sm:px-8 sm:py-32" aria-labelledby="install-title">
      <p class="label">Install</p>
      <h2 id="install-title" class="display mt-4 text-[clamp(2.4rem,5vw,4rem)] font-normal text-bark">
        One binary. <em>One minute.</em>
      </h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-bark/80">
        A single Go binary or a small distroless image for Linux, macOS and Windows, on amd64 and arm64. SQLite inside by
        default, PostgreSQL when you run several instances. Releases are signed and ship with an SBOM.
      </p>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <div class="rounded-xl border border-rule bg-white p-6">
          <h3 class="display text-2xl text-bark">Docker</h3>
          <p class="mt-2 text-sm text-mute">Open localhost:8080 and create the first admin.</p>
          <div class="mt-5"><CopyCommand command="docker run -p 8080:8080 -v rowbird-data:/data ghcr.io/rowbird/rowbird:1" wrap /></div>
        </div>
        <div class="rounded-xl border border-rule bg-white p-6">
          <h3 class="display text-2xl text-bark">The demo</h3>
          <p class="mt-2 text-sm text-mute">Sample data, a fake inbox and four reports, ready to run.</p>
          <div class="mt-5"><CopyCommand command="git clone https://github.com/rowbird/rowbird && cd rowbird/deploy/demo && docker compose up" wrap /></div>
        </div>
        <div class="rounded-xl border border-rule bg-white p-6">
          <h3 class="display text-2xl text-bark">Production</h3>
          <p class="mt-2 text-sm text-mute">Compose with Caddy and HTTPS, systemd, or Kubernetes.</p>
          <a href="https://docs.rowbird.dev/install/compose" class="mt-5 flex items-center justify-between rounded-xl border border-bark px-4 py-3 font-mono text-[0.95rem] text-bark transition hover:bg-bark hover:text-cream">
            docs.rowbird.dev/install <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="bg-breast text-bark" aria-labelledby="end-title">
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-10 px-5 py-20 sm:px-8 sm:py-24 md:flex-row md:items-center">
        <span class="block w-24 shrink-0 overflow-hidden rounded-3xl ring-4 ring-bark/15" set:html={icon} />
        <div class="flex-1">
          <h2 id="end-title" class="display text-[clamp(2.4rem,5.5vw,4.6rem)] font-normal">Stop pasting. Let the bird carry it.</h2>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/rowbird/rowbird" class="rounded-xl bg-bark px-5 py-3 font-medium text-cream transition hover:bg-ink">GitHub</a>
          <a href="https://docs.rowbird.dev" class="rounded-xl border border-bark px-5 py-3 font-medium text-bark transition hover:bg-bark hover:text-cream">Read the docs</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink text-cream/70">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 text-sm sm:px-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="display text-2xl text-paper">Rowbird</p>
        <p class="mt-2 max-w-sm leading-relaxed">
          Drawn after the sabiá-laranjeira, the national bird of Brazil, whose wing here is made of table rows.
        </p>
      </div>
      <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 font-mono">
        <a class="hover:text-breast" href="https://docs.rowbird.dev">Docs</a>
        <a class="hover:text-breast" href="https://github.com/rowbird/rowbird">GitHub</a>
        <a class="hover:text-breast" href="https://github.com/rowbird/rowbird/releases">Releases</a>
        <a class="hover:text-breast" href="https://github.com/rowbird/rowbird/blob/main/SECURITY.md">Security</a>
      </nav>
      <p class="font-mono text-xs">Apache 2.0 · No telemetry</p>
    </div>
  </footer>
</Base>
