---
interface Props { command: string; dark?: boolean; wrap?: boolean; small?: boolean }
const { command, dark = false, wrap = false, small = false } = Astro.props
---
<div class:list={['copy-cmd group flex items-stretch overflow-hidden rounded-xl border font-mono', small ? 'text-[0.82rem]' : 'text-[0.95rem]', dark ? 'border-bark-2 bg-ink text-cream' : 'border-bark bg-bark text-cream']}>
  <code class:list={['flex min-w-0 flex-1 gap-3 px-4 py-3', wrap ? 'items-start break-all whitespace-normal' : 'items-center overflow-x-auto whitespace-nowrap']}>
    <span class="text-breast select-none" aria-hidden="true">$</span><span data-cmd>{command}</span>
  </code>
  <button type="button" class="shrink-0 border-l border-bark-2 px-4 text-cream/80 transition hover:bg-bark-2 hover:text-cream" data-copy aria-label="Copy the command">
    <span data-label>Copy</span>
  </button>
</div>
<script>
  for (const el of document.querySelectorAll<HTMLElement>('.copy-cmd')) {
    const btn = el.querySelector<HTMLButtonElement>('[data-copy]')!
    const label = el.querySelector<HTMLElement>('[data-label]')!
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(el.querySelector('[data-cmd]')!.textContent ?? '')
      label.textContent = 'Copied'
      setTimeout(() => (label.textContent = 'Copy'), 1600)
    })
  }
</script>
